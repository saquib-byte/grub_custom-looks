# ============================================================
# grub_custom-looks — Active Configuration
# GitHub: https://github.com/YOUR_USERNAME/grub_custom-looks
#
# Edit this file to change your GRUB appearance,
# then run: sudo ./manage.sh --apply
# ============================================================

# --- THEME ---
# Available theme keys (run ./manage.sh --list to see all):
#   tela | vimix | stylish | whitesur
#   catppuccin-mocha | catppuccin-latte | catppuccin-frappe | catppuccin-macchiato
#   darkmatter | elegant-blur | elegant-dark
#   sleek-dark | sleek-light | sleek-orange
ACTIVE_THEME="elegant-dark"

# --- WALLPAPER ---
# "auto"         → use the theme's own bundled wallpaper (recommended)
# "tela.jpg"     → use a file from the wallpapers/ folder
# "myimage.png"  → use a file from wallpapers/custom/ folder
ACTIVE_WALL="auto"

# Path checked when ACTIVE_WALL is a custom filename:
CUSTOM_WALL_PATH="/home/mintian/grub_custom-looks/wallpapers/custom"

# --- ICON STYLE ---
# color      → Colorful OS icons  (works with: tela, vimix, stylish, whitesur)
# white      → White/mono icons   (works with: tela, vimix, stylish, whitesur)
# whitesur   → macOS-style icons  (works with: tela, vimix, stylish, whitesur)
ACTIVE_ICONS="color"

# --- DISPLAY RESOLUTION ---
# Match this to your monitor. Options: 1080p | 2k | 4k | ultrawide | ultrawide2k
RESOLUTION="1080p"

# --- SYSTEM PATHS (do not change unless you know what you're doing) ---
GRUB_THEMES_DIR="/usr/share/grub/themes"
GRUB_CONFIG="/etc/default/grub"
GFXMODE="1920x1080,auto"
ACTIVE_LAYOUT="center"
